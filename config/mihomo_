# --------------------- [7. 分流与隐私防泄漏规则 (Rules)] ---------------------
# 所有包含 IP 的 RULE-SET 均强制追加 ,no-resolve，严禁规则匹配中途触发本地 DNS 反查导致泄漏！
rules:
  # 1. 第一梯队：异地组网(Tailscale)、局域网、PT 站与直连白名单
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - IP-CIDR6,fd7a:115c:a1e0::/48,DIRECT,no-resolve
  - DST-PORT,41641,DIRECT
  - DOMAIN-SUFFIX,ts.net,DIRECT
  - DOMAIN-SUFFIX,tailscale.com,DIRECT
  - RULE-SET,private_domain,DIRECT
  - RULE-SET,lan_direct,DIRECT,no-resolve
  - RULE-SET,pt_direct,DIRECT,no-resolve
  - RULE-SET,custom_direct,DIRECT,no-resolve

  # 2. 隐私防旁路：封堵国产 App 私自 HttpDNS、浏览器外部 DoH 探测与 iCloud 专用代理（强迫全部走你的 53 端口 AGH）
  - RULE-SET,httpdns_block,AdBlock,no-resolve
  - DOMAIN,use-application-dns.net,AdBlock
  - DOMAIN,mask.icloud.com,AdBlock
  - DOMAIN,mask-h2.icloud.com,AdBlock
  - DST-PORT,853,Proxies

  # 3. WebRTC 严防真实 IPv4/IPv6 泄漏（放在国内规则之前！防止网页利用国内双栈 STUN 服务器借直连套出家庭真实公网 IP）
  - DST-PORT,3478,WebRTC
  - DST-PORT,5349,WebRTC
  - DST-PORT,19302,WebRTC
  - DOMAIN-KEYWORD,stun,WebRTC

  # 4. 特殊修正与防运营商劫持（常规域名去广告已交给 AdGuardHome）
  - DOMAIN-SUFFIX,jsdelivr.net,Proxies
  - RULE-SET,hijacking,AdBlock,no-resolve

  # 5. 海外 AI 优先分流（防落入香港节点）
  - RULE-SET,overseas_ai,Ai,no-resolve

  # 6. 港台番剧
  - RULE-SET,bahamut,Bahamut,no-resolve
  - RULE-SET,bilibili,Bilibili,no-resolve

  # 7. 游戏分流：国内下载 CDN 满速直连，商店/社区/联机走 Game 组
  - RULE-SET,steam_cn,DIRECT,no-resolve
  - RULE-SET,game_download_cn,DIRECT,no-resolve
  - RULE-SET,game,Game,no-resolve

  # 8. 微软与苹果：拆分 OneDrive 走代理，其余默认直连省流量
  - RULE-SET,onedrive,OneDrive,no-resolve
  - RULE-SET,microsoft,Microsoft,no-resolve
  - RULE-SET,apple,Apple,no-resolve

  # 9. 海外核心服务、流媒体与全球代理
  - RULE-SET,google_fcm,Proxies,no-resolve
  - RULE-SET,telegram,Telegram,no-resolve
  - RULE-SET,youtube,Media
  - RULE-SET,netflix,Media
  - RULE-SET,disney,Media
  - RULE-SET,tiktok,Media
  - RULE-SET,spotify,Media
  - RULE-SET,netflix_ip,Media,no-resolve
  - RULE-SET,proxy_gfw,Proxies,no-resolve
  - RULE-SET,proxy_media,Proxies

  # 10. 国内全量直连（cn_ip.mrs 已原生涵盖大陆全量 IPv4 与 IPv6 网段）
  - RULE-SET,gov_cn,DIRECT,no-resolve
  - RULE-SET,cloud_cn,DIRECT,no-resolve
  - RULE-SET,cn_domain,DIRECT
  - RULE-SET,cn_ip,DIRECT,no-resolve

  # 11. 最终兜底
  - MATCH,Final
